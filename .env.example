# Google Gemini API Key (必需，用于大模型深度提炼)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini 模型选择 (默认 gemini-2.5-flash)
# 可选值: gemini-2.5-flash, gemini-2.5-pro, gemini-2.0-flash 等
GEMINI_MODEL=gemini-2.5-flash

# 网络代理 (可选，国内网络环境推荐配置)
# 示例: http://127.0.0.1:7890 或 socks5://127.0.0.1:10808
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# 研报与索引生成的输出根目录 (默认 output)
OUTPUT_DIR=output

# 字幕与文稿语言优先级 (逗号分隔)
TRANSCRIPT_LANGUAGES=en,zh-Hans,zh-Hant,zh,ja

# 字幕请求保护：批量抓取时避免连续触发 YouTube 429
SUBTITLE_MIN_REQUEST_INTERVAL=5
# 429 时不重试，立即停止当前任务
SUBTITLE_MAX_RETRIES=0
SUBTITLE_BACKOFF_SECONDS=3
# 持久化冷却至少一天，重启程序后仍然生效
SUBTITLE_COOLDOWN_SECONDS=86400
